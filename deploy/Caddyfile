# Replace example.com with the public domain, then install this as /etc/caddy/Caddyfile.
# Caddy is the only process that listens on 80 and 443. The Node process stays on 127.0.0.1.
# Do not add a file_server root of /apps. Each application is reached through its own reverse_proxy.
example.com {
	encode gzip

	redir /allapps /allapps/ permanent

	handle /allapps/* {
		reverse_proxy 127.0.0.1:3001
	}

	# Repeat this block for each other application, with that app's path and loopback port.
	# handle /poolcomp/* {
	# 	reverse_proxy 127.0.0.1:3002
	# }
}
